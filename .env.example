# ============================================
# True Claim Insight - Environment Variables
# ============================================
# Copy this file to .env for local development
# cp .env.example .env

# ============ APPLICATION ============
NODE_ENV=development
LOG_LEVEL=debug

# ============ DATABASE ============
DATABASE_URL=postgresql://tci:localdev@localhost:5432/true_claim_insight

# ============ REDIS ============
REDIS_URL=redis://localhost:6380

# ============ AWS (LocalStack for dev) ============
AWS_REGION=ap-southeast-5
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=localstack
AWS_SECRET_ACCESS_KEY=localstack
S3_BUCKET_DOCUMENTS=tci-documents
S3_BUCKET_RECORDINGS=tci-recordings

# ============ JWT ============
JWT_SECRET=local-dev-secret-change-in-production
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# ============ SMTP (MailHog for dev) ============
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@trueclaiminsight.local

# ============ THIRD-PARTY APIs ============
# Obtain credentials from vendors for development/sandbox accounts

# Tencent TRTC (Video Calls)
# Register at: https://cloud.tencent.com/product/trtc
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=

# Innov8tif (eKYC)
# Contact: https://innov8tif.com
INNOV8TIF_API_KEY=
INNOV8TIF_ENCRYPTION_KEY=

# Clearspeed (Voice Risk Analysis)
# Contact: https://clearspeed.com
CLEARSPEED_API_KEY=

# Hive AI (Visual Moderation)
# Register at: https://hivemoderation.com
HIVE_API_KEY=

# SigningCloud (Digital Signatures)
# Contact: https://signingcloud.com
SIGNINGCLOUD_CLIENT_ID=
SIGNINGCLOUD_CLIENT_SECRET=

# ============ SERVICE PORTS ============
# THE single source of truth for local host ports. Each service reads its OWN
# named variable here, with precedence PORT > <SERVICE>_PORT > the value
# compiled into its main.ts. Reading a different name per service is what lets
# one shared file allocate the whole stack: apps/api-gateway/.env is a symlink
# to this file and the other services read it too, so a bare PORT here would
# make every service fight for the same number.
#
# These are HOST ports only. Container ports are a separate namespace —
# staging runs case-service on :3001 of the compose network, which is what the
# compiled-in defaults mean. Do not "align" the two.
#
# The 33xx/43xx block is deliberate: 3000-3002 and 4000-4001 are what every
# framework grabs by default, so on a machine running more than one project
# they collide. Pick an unused block per project and the problem stops
# recurring. Nothing is allocated at 3303 — identity-service does not exist.
API_GATEWAY_PORT=3300
CASE_SERVICE_PORT=3301
VIDEO_SERVICE_PORT=3302
RISK_ENGINE_PORT=3304
RISK_ANALYZER_PORT=3305
ADJUSTER_PORTAL_PORT=4300
CLAIMANT_WEB_PORT=4301

# Browser origins allowed to call the APIs with credentials — must track the
# portal ports above. The portals themselves need no API URL: they default to
# the same-origin path /api/v1 and Vite proxies it to API_GATEWAY_PORT.
CORS_ORIGINS=http://localhost:4300,http://localhost:4301

# Handling firm for claimant self-service intake (an ADJUSTING_FIRM tenant id).
# Required for the claimant web-chat intake: the case must be routed to a named
# firm rather than an arbitrarily chosen one. An insurer tenant can override this
# per panel via its settings.handlingFirmTenantId.
HANDLING_FIRM_TENANT_ID=

# Shared secret proving a request came from the api-gateway. Required by
# case-service, video-service and risk-engine before they will trust the
# forwarded X-User-Id / X-Tenant-Id / X-User-Role identity headers.
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
INTERNAL_API_KEY=

# Shared secret for the Daily.co webhook ingress on video-service. Register the
# webhook URL with Daily as https://<host>/webhooks/daily?token=<this value>.
# Unset means webhook delivery is refused (off, not open).
DAILY_WEBHOOK_SECRET=

# Telegram long-polling is a fleet-wide singleton: two pollers on one bot token
# each receive half the updates. Opt-in — set true on exactly ONE instance.
TELEGRAM_POLLING_ENABLED=

# Public HTTPS origin of claimant-web. Enables the Telegram Mini App: the bot
# offers an "Open the form" button on date, document and review steps, which
# opens <this>/tg inside Telegram.
#
# UNSET BY DEFAULT, and the button simply does not appear without it. Telegram
# will only open an origin it can reach over HTTPS, so localhost cannot work —
# testing this needs a tunnel, alongside the WhatsApp one in
# ~/.cloudflared/tci-whatsapp.yml. An http:// value is ignored rather than
# offered, because a button that opens nothing is worse than no button.
CLAIMANT_WEB_URL=

# Webhook OCR for claim document extraction. UNSET BY DEFAULT: the destination
# receives claim document images (MyKad, receipts, damage photos), so enabling
# it is a cross-border transfer decision needing a basis and a TransferRecord
# (MASTER_PLAN §3.4), not a config convenience.
OCR_WEBHOOK_URL=

# Which LLM backend risk-engine uses. LOCAL BY DEFAULT - leave this unset.
#
#   (unset) or ollama  the local models on the GPU host. Nothing leaves it.
#   gemini             Google Gemini. Offshore, and a deliberate choice.
#
# The rule this replaced was "GEMINI_API_KEY is set -> use Gemini", so a key
# left in a .env file was enough to send claimant documents to Google without
# anyone deciding to. No cross-border transfer basis is established
# (MASTER_PLAN section 3.4), so the platform runs on local models for now.
# An unrecognised value logs a warning and stays local; it does not throw.
LLM_PROVIDER=

# Only read when LLM_PROVIDER=gemini. Setting it alone no longer selects Gemini.
GEMINI_API_KEY=

# Self-hosted Ollama on the office GPU box (docs/GPU_HOST_SETUP.md), used by
# risk-engine's OllamaGpuLlmProvider for document extraction.
#
# UNSET BY DEFAULT, and the provider now throws rather than falling back. It
# previously defaulted to a hardcoded Cloudflare quick-tunnel that had long
# since died, so a missing config silently addressed a dead host instead of
# failing. Fail loudly; do not reintroduce a default.
#
# Reachable only from the tailnet:
#   GPU_SERVICE_URL=http://tci-gpu-host.<your-tailnet>.ts.net:11434
#
# NOT a sovereignty control. It is an office desktop on a private network, not
# controlled in-country infrastructure - MASTER_PLAN section 3.4 is unchanged.
GPU_SERVICE_URL=

# Surya OCR, on the SAME MACHINE but a DIFFERENT SERVICE and port. One URL
# cannot front both, which is what the old /v3 client assumed:
#   SURYA_SERVICE_URL=http://tci-gpu-host.<your-tailnet>.ts.net:8002
#
# Unset by default and the provider throws rather than guessing, for the same
# reason GPU_SERVICE_URL has no default.
#
# This is where document grounding comes from. POST /ocr returns, per line,
# text + confidence + bbox [x0,y0,x1,y1], which is what satisfies the
# page-and-bounding-box rule in CASE_VERIFICATION_ENGINE.md section 8. Surya is
# discriminative and cannot invent text that is not on the page; no LLM should
# be asked for coordinates. Do not call /analyze - it takes the same request but
# returns bank-statement fields from an unrelated loan-application system. See
# docs/gpu-api-contract.md section 5.
SURYA_SERVICE_URL=

# Which model serves each job. Unset = the tags verified against the Ollama
# registry and pulled onto the host on 19 Aug 2026; override when the host's
# models change, rather than editing the provider.
#
# These were literals in ollama-gpu-llm.provider.ts, and by the time the host
# was surveyed not one of them was still on it. Config beats a constant that
# was true once. Whatever is in force is logged when risk-engine starts.
#
# GPU_MODEL_VISION reads the claim documents. It defaults to qwen3-vl:8b rather
# than the better NuExtract3, and the reason is narrower than it once said here.
# NuExtract3 is NOT wrong under instruction-plus-schema in general -- name every
# required field in the prompt and it answers correctly. What it does is return
# the schema's own type name, the literal string "string", for any required
# field the prompt does not explicitly ask for.
#
# That is the normal case rather than an edge case: real schemas have many
# fields, no prompt enumerates them all, and the answer is schema-valid so
# constrained decoding cannot catch it. Measured on the host, both prompts, two
# runs each - docs/gpu-api-contract.md section 3.
GPU_MODEL_TEXT=
GPU_MODEL_VISION=
GPU_MODEL_REASONING=

# Master key (KEK) for field-level encryption of personal data. 32 bytes, base64.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store a copy in a password manager — LOSING THIS MAKES ENCRYPTED DATA UNRECOVERABLE.
# Use a different key per environment; never promote the dev key to production.
# Production custody is AWS KMS (see common/crypto/key-provider.interface.ts).
ENCRYPTION_MASTER_KEY=

# Secret pepper for the NRIC blind index (nricHash), enabling exact-match
# lookup on an encrypted NRIC. HMAC, not a bare hash: a Malaysian NRIC is 12
# structured digits and an unpeppered rainbow table is trivial.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# EFFECTIVELY PERMANENT — changing it invalidates every stored nricHash and
# breaks NRIC lookups until all values are re-indexed. Unlike the encryption
# key, it is not designed to rotate. Back it up with the master key.
NRIC_INDEX_PEPPER=

# --- WhatsApp Business API (claimant login codes) ---------------------------
# Unset ⇒ the console fallback runs and, outside production, the code is
# returned in the send-otp response so login still works. Production refuses
# to return a code, so all three must be set there.
#
# Register the WhatsApp Business Account in MALAYSIA. Sending to Malaysian
# numbers from an account registered elsewhere is billed at Meta's
# authentication-international rate (~RM 0.1685) rather than the domestic one
# (~RM 0.0564) — three times the price for an identical message.
#
# The template must be AUTHENTICATION category with a copy-code button. One-tap
# and zero-tap autofill need a native Android package name and signature hash;
# the claimant app is a PWA, so copy-code is the only option available.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LOCALE=en
WHATSAPP_API_VERSION=v21.0

# --- WhatsApp as a conversational channel -----------------------------------
# The same WABA and token as the login codes above. Unset ⇒ the adapter is
# registered but inert, exactly like Telegram without a bot token.
#
# APP_SECRET verifies Meta's X-Hub-Signature-256 on every inbound delivery.
# Unset ⇒ every delivery is DISCARDED, not trusted: the endpoint is public and
# the payload names a claimant's phone number.
#
# VERIFY_TOKEN is any string you choose; Meta echoes it back once when the
# webhook URL is saved. Failing that handshake is the commonest reason a
# WhatsApp integration appears to do nothing at all.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Reaching a claimant after the 24-hour service window has closed.
#
# The window runs from the claimant's own last message. Inside it, ordinary
# text is free-form and free of charge; outside it Meta refuses free-form text
# (error 131047), and only a template it has approved gets through. That is
# exactly the claimant an information request is for — one who went quiet.
#
# UTILITY category, not marketing: this concerns a claim the claimant already
# opened. See docs/WHATSAPP_TEMPLATES.md for the exact text to submit.
# Unset ⇒ no template is sent and nothing breaks; the conversation resumes on
# the claimant's next message instead.
WHATSAPP_INFO_REQUEST_TEMPLATE=
WHATSAPP_TEMPLATE_LOCALE=en
