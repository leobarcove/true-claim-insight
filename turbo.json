{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "REDIS_URL"],
  "tasks": {
    "setup": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"],
      // VITE_* is part of the key because Vite INLINES these values into the
      // bundle: two builds of identical source with different VITE_AGENT_HOSTS
      // produce different output, and only this line says so. Without it a warm
      // cache returns the earlier bundle — the right source, the wrong
      // hostname, and no error anywhere. Harmless while every build starts
      // cold; a silent wrong answer as soon as the cache persists, which it
      // now does in deploy/staging/Dockerfile.
      "env": ["NODE_ENV", "VITE_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      // "dependsOn": ["build"]
    },
    "lint": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": ["build"]
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
