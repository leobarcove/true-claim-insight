generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(uuid())
  email            String             @unique
  password         String
  fullName         String
  phoneNumber      String
  role             UserRole
  licenseNumber    String?
  avatarUrl  String?
  tenantId         String? // Deprecated: kept for backward compatibility
  currentTenantId  String? // Active tenant context for current session
  isVerified       Boolean            @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  adjuster         Adjuster?
  siuClaims        Claim[]            @relation("SIUInvestigator")
  tenant           Tenant?            @relation("UserPrimaryTenant", fields: [tenantId], references: [id])
  currentTenant    Tenant?            @relation("UserCurrentTenant", fields: [currentTenantId], references: [id])
  userTenants      UserTenant[]       // Many-to-many relationship with tenants
  tenantAccessLogs TenantAccessLog[]
  sessions         Session[]
  documents        Document[]
  documentAnalyses DocumentAnalysis[]
  trinityChecks    TrinityCheck[]
  deceptionScores  DeceptionScore[]
  riskAssessments  RiskAssessment[]
  videoUploads     VideoUpload[]
  claimants        Claimant[]
  otpCodes         OtpCode[]
  vehicleMakes     VehicleMake[]
  vehicleModels    VehicleModel[]
  claimNotes       ClaimNote[]
  sessionClientInfos SessionClientInfo[]
  auditTrails      AuditTrail[]
  claims           Claim[]


  @@index([tenantId])
  @@index([currentTenantId])
  @@index([email])
  @@map("users")
}

model UserTenant {
  id             String    @id @default(uuid())
  userId         String
  tenantId       String
  role           UserRole // Role specific to this tenant
  isDefault      Boolean   @default(false) // Default tenant for this user
  status         UserTenantStatus @default(ACTIVE)
  joinedAt       DateTime  @default(now())
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@index([userId, tenantId])
  @@map("user_tenants")
}

model TenantAccessLog {
  id            String   @id @default(uuid())
  userId        String
  fromTenantId  String?
  toTenantId    String
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromTenant    Tenant?  @relation("TenantAccessFrom", fields: [fromTenantId], references: [id], onDelete: SetNull)
  toTenant      Tenant   @relation("TenantAccessTo", fields: [toTenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("tenant_access_logs")
}

model Tenant {
  id                  String            @id @default(uuid())
  name                String
  type                TenantType
  subscriptionTier    SubscriptionTier  @default(BASIC)
  settings            Json              @default("{}")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  adjusters           Adjuster[]
  claims              Claim[]           @relation("InsurerClaims")
  users               User[]            @relation("UserPrimaryTenant") // Deprecated: for backward compatibility
  currentUsers        User[]            @relation("UserCurrentTenant") // Users currently in this tenant context
  userTenants         UserTenant[]      // Many-to-many relationship with users
  tenantAccessLogsFrom TenantAccessLog[] @relation("TenantAccessFrom")
  tenantAccessLogsTo   TenantAccessLog[] @relation("TenantAccessTo")
  sessions            Session[]
  claimNotes          ClaimNote[]
  deceptionScores     DeceptionScore[]
  riskAssessments     RiskAssessment[]
  documents           Document[]
  documentAnalyses    DocumentAnalysis[]
  trinityChecks       TrinityCheck[]
  auditLogs           AuditTrail[]
  videoUploads        VideoUpload[]
  sessionClientInfos  SessionClientInfo[]
  claimants           Claimant[]
  otpCodes            OtpCode[]
  vehicleMakes        VehicleMake[]
  vehicleModels       VehicleModel[]
  ownedClaims         Claim[]
  floodClaims         FloodClaim[]
  travelClaims        TravelClaim[]
  evidenceRequirements EvidenceRequirement[]
  cases               Case[]
  policies            Policy[]

  @@map("tenants")
  slaPolicies      SlaPolicy[]
  authorityLimits  AuthorityLimit[]
  assignmentsAsInsurer  Assignment[] @relation("AssignmentInsurer")
  assignmentsAsHandler  Assignment[] @relation("AssignmentHandlingFirm")
}

model Adjuster {
  id                String         @id @default(uuid())
  userId            String         @unique
  tenantId          String
  licenseNumber     String         @unique
  bcillaCertified   Boolean        @default(false)
  amlaMember        Boolean        @default(false)
  status            AdjusterStatus @default(ACTIVE)
  licenseVerifiedAt DateTime?
  /// When this person began adjusting employment with the firm. PD 12.3: a new
  /// adjusting employee is closely supervised by a senior for at least one year
  /// before conducting adjusting work independently — supervision status is
  /// derived from this date, so it cannot silently be forgotten.
  adjustingSince    DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  user              User           @relation(fields: [userId], references: [id])
  claims            Claim[]

  @@index([tenantId])
  @@map("adjusters")
  authoredReports   AdjusterReport[] @relation("ReportAuthor")
  reviewedReports   AdjusterReport[] @relation("ReportReviewer")
  signedReports     AdjusterReport[] @relation("ReportSigner")
  authorityLimits   AuthorityLimit[]
  competencies      AdjusterCompetency[]
  conflictDeclarations ConflictDeclaration[]
  conflictAttestations ConflictAttestation[]
  cpdRecords           CpdRecord[]
  backgroundScreenings BackgroundScreening[]
}

model Claimant {
  id            String    @id @default(uuid())
  /// Blind index (HMAC-SHA256 of the normalised NRIC with a secret pepper).
  /// Carries the uniqueness that plaintext `nric` used to, and is the only way
  /// to look a claimant up by NRIC. HMAC not a bare hash: a Malaysian NRIC is
  /// 12 structured digits, so an unpeppered rainbow table is trivial.
  nricHash      String?   @unique
  /// Encrypted NRIC (v<n>:<iv>:<ciphertext>:<tag>).
  nricEncrypted String?
  /// Last 4 digits, clear, so screens can identify a person without decrypting.
  nricLast4     String?
  fullName      String?
  dateOfBirth   DateTime?
  phoneNumber   String    @unique
  email         String?
  kycStatus     KycStatus @default(PENDING)
  kycVerifiedAt DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenantId      String?   // Organization ownership
  userId        String?   // Creator/Link to User record
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  user          User?     @relation(fields: [userId], references: [id])
  claims        Claim[]
  cases         Case[]

  @@index([phoneNumber])
  @@index([tenantId])
  @@index([userId])
  @@map("claimants")
  consents         Consent[]
}

model OtpCode {
  id          String   @id @default(uuid())
  phoneNumber String
  code        String
  expiresAt   DateTime
  verified    Boolean  @default(false)
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  tenantId    String?  // Associated tenant if known
  userId      String?  // Associated user if known
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@index([phoneNumber, code])
  @@index([expiresAt])
  @@index([tenantId])
  @@index([userId])
  @@map("otp_codes")
}

model Claim {
  id                      String      @id @default(uuid())
  claimNumber             String      @unique
  claimantId              String
  /// Encrypted NRIC snapshot for this claim; see Claimant.nricEncrypted.
  nricEncrypted           String?
  nricLast4               String?
  adjusterId              String?
  insurerTenantId         String?
  policyNumber            String
  // Coarse-grained category drives the polymorphic sub-table relation and
  // determines which evidence checklist + fraud providers apply.
  category                ClaimCategory @default(MOTOR)
  // Motor-specific subtype. Required when category=MOTOR, otherwise nullable.
  claimType               ClaimType?
  status                  ClaimStatus @default(SUBMITTED)
  incidentDate            DateTime
  incidentTime            DateTime?
  incidentLocation        Json
  description             String
  otherParty              Json?
  policeReportNumber      String?
  policeStation           String?
  policeReportDate        DateTime?
  vehiclePlateNumber      String?
  vehicleChassisNumber    String?
  vehicleMake             String?
  vehicleModel            String?
  ncdRate                 Float?
  sumInsured              Decimal?
  workshopName            String?
  estimatedLossAmount     Decimal?
  estimatedRepairCost     Decimal?    @db.Decimal(12, 2)
  sstAmount               Decimal?
  isPdpaCompliant         Boolean     @default(false)
  slaDeadline             DateTime?
  complianceNotes         Json?       @default("{}")
  priority                Priority    @default(NORMAL)
  scheduledAssessmentTime DateTime?
  siuInvestigatorId       String?
  approvedAmount          Decimal?
  excessAmount            Decimal?
  vehicleEngineNumber     String?
  vehicleYear             Int?
  /// When the claim reached CLOSED — the anchor the 7-year retention period
  /// runs from. Nothing belonging to a claim may be purged before this + the
  /// retention period.
  closedAt                DateTime?
  /// Legal hold: suspends purging regardless of retention arithmetic. Litigation
  /// or a regulator's request outranks the calendar.
  legalHoldAt             DateTime?
  legalHoldReason         String?
  legalHoldByUserId       String?
  tenantId                String?     // Standardized tenant ownership
  userId                  String?     // Standardized creator/owner
  createdById             String?     // Keeping for backward compatibility
  updatedById             String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  notes                   ClaimNote[]
  adjuster                Adjuster?   @relation(fields: [adjusterId], references: [id])
  claimant                Claimant    @relation(fields: [claimantId], references: [id])
  tenant                  Tenant?     @relation(fields: [tenantId], references: [id])
  user                    User?       @relation(fields: [userId], references: [id])
  insurerTenant           Tenant?     @relation("InsurerClaims", fields: [insurerTenantId], references: [id])
  siuInvestigator         User?       @relation("SIUInvestigator", fields: [siuInvestigatorId], references: [id])
  documents               Document[]
  sessions                Session[]
  videoUploads            VideoUpload[]
  trinityChecks           TrinityCheck[]
  // Per-category polymorphic sub-tables. Exactly one should be populated,
  // matching the value in `category`.
  floodClaim              FloodClaim?
  travelClaim             TravelClaim?
  // Pre-claim intake request this claim was converted from, if any.
  sourceCase              Case?
  fraudSignals            FraudSignal[]

  @@index([claimantId])
  @@index([adjusterId])
  @@index([status])
  @@index([tenantId])
  @@index([userId])
  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@map("claims")
  slaClocks               SlaClock[]
  reports                 AdjusterReport[]
  assignment              Assignment?
  conflictAttestations    ConflictAttestation[]
}

// ============================================================================
// Non-motor: Flood (first non-motor type — Klang Valley monsoon, flash floods,
// coastal surge). Pattern is reusable for Fire, Lightning, Burglary etc.
//
// Fields mirror what overseas systems anchor on:
//  - elevationMeters / floorLevel: NFIP/FEMA elevation certificate pattern
//  - postcode + jpsGaugeId: enables JPS InfoBanjir gauge cross-reference
//  - parametricTriggerMet: Swiss Re parametric flood pattern
//  - metMalaysiaEventRef: named storm/monsoon event linkage
// ============================================================================
model FloodClaim {
  id                       String         @id @default(uuid())
  claimId                  String         @unique
  tenantId                 String?

  // Incident specifics
  incidentStart            DateTime
  incidentEnd              DateTime?
  waterDepthCm             Int?
  durationHours            Int?
  source                   FloodSource?

  // Property + geography
  propertyType             PropertyType?
  propertyFloorLevel       Int?
  propertyElevationMeters  Float?
  postcode                 String?
  state                    String?

  // External verification — written by FraudSignalProvider plugins
  parametricTriggerMet     Boolean?
  metMalaysiaEventRef      String?
  jpsGaugeId               String?

  // Damage breakdown (claimant-declared, validated by inspection)
  buildingDamageRm         Decimal?       @db.Decimal(12, 2)
  contentsDamageRm         Decimal?       @db.Decimal(12, 2)
  vehicleDamageRm          Decimal?       @db.Decimal(12, 2)

  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  claim                    Claim          @relation(fields: [claimId], references: [id])
  tenant                   Tenant?        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([incidentStart])
  @@index([postcode])
  @@map("flood_claims")
}

// ============================================================================
// Non-motor: Travel (TPA model — travel claim requests captured as Cases and
// converted into Claim + TravelClaim on operator approval). Mirrors the
// FloodClaim polymorphic sub-table pattern.
// ============================================================================
model TravelClaim {
  id                 String          @id @default(uuid())
  claimId            String          @unique
  tenantId           String?
  travelClaimType    TravelClaimType
  policyId           String?         // carried from the source Case

  // Trip context
  tripStartDate      DateTime?
  tripEndDate        DateTime?
  destinationCountry String?

  // Flight delay
  airline            String?
  flightNumber       String?
  scheduledDeparture DateTime?
  actualDeparture    DateTime?
  delayHours         Float?

  // Luggage damage / loss
  baggageTagNumber   String?

  // Medical (form + expert routing only — never auto-assessed)
  treatmentCountry   String?
  hospitalName       String?
  referredToExpert   Boolean         @default(false)

  // Trip cancellation
  cancellationReason String?

  estimatedAmountRm  Decimal?        @db.Decimal(12, 2)

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  claim              Claim           @relation(fields: [claimId], references: [id])
  tenant             Tenant?         @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("travel_claims")
}

// ============================================================================
// TPA intake — Policy data supplied by the insurer (MSIG). Today this arrives
// manually via email; later via API integration or agency-portal scraping.
// Both future adapters upsert rows here with the appropriate `source`.
// ============================================================================
/// Wrapped data-encryption keys (envelope encryption).
///
/// Field values are encrypted with a data key (DEK); the DEK itself is stored
/// here wrapped by a master key (KEK) held outside the database — in the
/// environment today, in AWS KMS later. Migrating to KMS therefore means
/// re-wrapping this one row, NOT re-encrypting any data.
///
/// Multiple rows may coexist so a key can be rotated gradually: every
/// ciphertext carries the version that produced it.
model EncryptionKey {
  id              String    @id @default(uuid())
  version         Int       @unique
  wrappedDataKey  String    // DEK encrypted by the master key
  algorithm       String    @default("aes-256-gcm")
  createdAt       DateTime  @default(now())
  retiredAt       DateTime? // set when no longer used for new writes

  @@map("encryption_keys")
}

model Policy {
  id               String       @id @default(uuid())
  tenantId         String       // Insurer tenant (e.g. MSIG)
  policyNumber     String
  insuredName      String
  insuredNricEncrypted String?
  insuredNricLast4 String?
  insuredPhone     String?
  planTier         String?
  tripStartDate    DateTime?
  tripEndDate      DateTime?
  destination      String?
  coverageSnapshot Json?        // benefits/limits exactly as supplied
  source           PolicySource @default(MANUAL)
  externalRef      String?      // insurer API id / scrape reference (future)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  cases            Case[]

  @@unique([tenantId, policyNumber])
  @@index([tenantId, insuredPhone])
  @@map("policies")
}

// ============================================================================
// Case — pre-claim intake request (FNOL). Channel-agnostic conversational
// artifact: web chat wizard, staff capture, logged email, or (future)
// WhatsApp bot / system-initiated proactive cases. A human operator vets the
// case and converts it into a Claim (+ TravelClaim) — the insurer handback.
// ============================================================================
model Case {
  id                    String           @id @default(uuid())
  caseNumber            String           @unique        // CSE-2026-000001 via case_number_seq
  tenantId              String
  channel               CaseChannel      @default(WEB_CHAT)
  initiatedBy           CaseInitiator    @default(CLAIMANT)
  status                CaseStatus       @default(DRAFT)
  category              ClaimCategory    @default(TRAVEL)
  travelClaimType       TravelClaimType?
  claimantId            String?
  createdByUserId       String?          // staff capture / email logging
  policyId              String?
  policyNumberRaw       String?          // as typed/extracted, pre-match
  needsPolicyReview     Boolean          @default(false) // no auto-match found
  currentStepId         String?          // conversational cursor for resume
  answers               Json             @default("{}") // Record<stepId, value>; pre-filled for SYSTEM cases
  incidentDate          DateTime?        // promoted for queue + deadline calc
  destination           String?          // promoted for queue display
  sourceMeta            Json?            // EMAIL: {from, subject, receivedAt}; WHATSAPP later
  bankName              String?          // not an identifier; stored in the clear
  /// Encrypted payout account number (v<n>:<iv>:<ciphertext>:<tag>).
  /// Never expose to a claimant; decrypt only for payout/operator review.
  bankAccountNumberEncrypted String?
  /// Last 4 digits kept in the clear so operator screens can display an
  /// account without decrypting anything.
  bankAccountLast4      String?
  bankAccountHolderName String?
  notifiedLate          Boolean          @default(false) // notified >24h after incident
  outOfWindow           Boolean          @default(false) // notified >30 days after incident
  reviewNote            String?          // info request / expert note / reject reason
  convertedClaimId      String?          @unique
  submittedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  tenant                Tenant           @relation(fields: [tenantId], references: [id])
  claimant              Claimant?        @relation(fields: [claimantId], references: [id])
  policy                Policy?          @relation(fields: [policyId], references: [id])
  convertedClaim        Claim?           @relation(fields: [convertedClaimId], references: [id])
  documents             CaseDocument[]

  @@index([tenantId, status])
  @@index([claimantId])
  @@index([createdAt(sort: Desc)])
  @@map("cases")
}

model CaseDocument {
  id               String                   @id @default(uuid())
  caseId           String
  tenantId         String
  documentType     DocumentType
  fileName         String
  storagePath      String                   // same StorageService bucket as claim documents
  mimeType         String?
  sizeBytes        Int?
  stepId           String?                  // which intake step produced it
  // Local-LLM document validation hook (name match, completeness).
  // Slice 1 sets SKIPPED; the validation service fills these in later.
  validationStatus DocumentValidationStatus @default(SKIPPED)
  validationNote   String?
  createdAt        DateTime                 @default(now())
  case             Case                     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("case_documents")
}

// ============================================================================
// Fraud signal records — Shift Technology pattern.
// Each detector (parametric weather check, document forgery, repeat claimant,
// behavioural Hume score, etc.) writes one row per signal it produces.
// The risk-engine fuses signals into an overall score; the adjuster UI lists
// individual signals with severity + evidence.
// ============================================================================
model FraudSignal {
  id          String         @id @default(uuid())
  claimId     String
  // Free-form provider id (e.g. "MetMalaysiaRainfall", "RepeatClaimantGraph",
  // "HumeBehavioural"). Kept as string rather than enum so plugins can register
  // without schema migrations.
  provider    String
  category    FraudCategory
  signalType  String
  severity    SignalSeverity
  confidence  Float
  message     String?
  rawData     Json           @default("{}")
  createdAt   DateTime       @default(now())

  claim       Claim          @relation(fields: [claimId], references: [id])

  @@index([claimId])
  @@index([provider])
  @@index([category])
  @@index([severity])
  @@map("fraud_signals")
}

// ============================================================================
// Evidence checklist — data-driven per ClaimCategory + tenant.
// Lets each insurer define their own required documents for each claim type
// without code changes. Null tenantId = global default.
// ============================================================================
model EvidenceRequirement {
  id           String        @id @default(uuid())
  tenantId     String?
  category     ClaimCategory
  // Travel subtype refinement — null for non-travel categories, letting each
  // travel claim type (flight delay, luggage loss, ...) have its own checklist.
  travelClaimType TravelClaimType?
  documentType DocumentType
  isMandatory  Boolean       @default(true)
  description  String?
  sortOrder    Int           @default(0)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant       Tenant?       @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, category, travelClaimType, documentType])
  @@index([category])
  @@map("evidence_requirements")
}

model ClaimNote {
  id         String    @id @default(uuid())
  claimId    String
  content    String
  isPrivate  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  tenantId   String?   // Organization ownership
  userId     String?   // Creator (linked to User)
  authorId   String    // Generic author ID (can be user or claimant)
  authorType ActorType
  claim      Claim     @relation(fields: [claimId], references: [id])
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])
  user       User?     @relation(fields: [userId], references: [id])

  @@index([claimId])
  @@index([tenantId])
  @@index([userId])
  @@map("claim_notes")
}

model Session {
  id              String           @id @default(uuid())
  claimId         String
  tenantId        String? // Tenant context for this session
  roomId          BigInt
  status          SessionStatus    @default(SCHEDULED)
  scheduledTime   DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  recordingUrl    String?
  analysisStatus  AnalysisStatus   @default(PENDING)
  screenshots     Json             @default("[]")
  createdAt       DateTime         @default(now())
  roomUrl         String?
  riskAssessments RiskAssessment[]
  deceptionScores DeceptionScore[]
  clientInfos     SessionClientInfo[]
  claim           Claim            @relation(fields: [claimId], references: [id])
  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  userId          String?          // User who scheduled/initiated
  user            User?            @relation(fields: [userId], references: [id])

  @@index([claimId])
  @@index([tenantId])
  @@map("sessions")
}

model DeceptionScore {
  id                    String   @id @default(uuid())
  sessionId             String
  deceptionScore        Decimal  @db.Decimal(5, 4)
  voiceStress           Decimal  @db.Decimal(5, 4)
  visualBehavior        Decimal  @db.Decimal(5, 4)
  expressionMeasurement Decimal  @db.Decimal(5, 4)
  createdAt             DateTime @default(now())
  tenantId              String?  // Denormalized for reporting
  userId                String?  // Who triggered analysis
  session               Session  @relation(fields: [sessionId], references: [id])
  tenant                Tenant?  @relation(fields: [tenantId], references: [id])
  user                  User?    @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@map("deception_scores")
}

model RiskAssessment {
  id             String         @id @default(uuid())
  sessionId      String
  assessmentType AssessmentType
  provider       String
  questionId     String?
  questionText   String?
  riskScore      RiskScore?
  confidence     Decimal?       @db.Decimal(5, 4)
  rawResponse    Json?
  contextData    Json?
  createdAt      DateTime       @default(now())
  tenantId       String?        // Denormalized for reporting
  userId         String?        // Who triggered analysis
  session        Session        @relation(fields: [sessionId], references: [id])
  tenant         Tenant?        @relation(fields: [tenantId], references: [id])
  user           User?          @relation(fields: [userId], references: [id])

  @@index([sessionId, assessmentType])
  @@index([sessionId])
  @@map("risk_assessments")
}

model Document {
  id           String       @id @default(uuid())
  claimId      String
  type         DocumentType
  filename     String
  storageUrl   String
  fileSize     Int?
  mimeType     String?
  status       DocumentStatus @default(QUEUED)
  metadata     Json         @default("{}")
  // ===== Digital signature lifecycle =====
  // Set on every Document so we can show a "not requested" badge on the UI
  // for non-signable docs (photos, receipts) as well as track the lifecycle
  // for consent forms. The provider abstraction (Stub today, SigningCloud
  // later) writes these columns through case-service's SignaturesService.
  signatureStatus      SignatureStatus @default(NOT_REQUESTED)
  signatureRequestId   String?         // External provider reference (SigningCloud envelope id)
  signatureUrl         String?         // URL the signer (claimant) opens to sign
  signatureRequestedAt DateTime?       // When the signing request was created
  signedAt             DateTime?       // When the claimant completed signing
  signedStorageUrl     String?         // URL of the countersigned PDF (signed PDF stored separately)
  documentHash         String?
  /// Soft delete (PD 12.8). A "deleted" document is hidden from ordinary use but
  /// retained — row and stored file — until the retention sweep purges it after
  /// the claim's retention period, and never while a legal hold stands.
  deletedAt       DateTime?
  deletedByUserId String?
  deleteReason    String?
  createdAt    DateTime     @default(now())
  tenantId     String?      // Organization ownership
  userId       String?      // Uploader ID
  claim        Claim             @relation(fields: [claimId], references: [id])
  tenant       Tenant?           @relation(fields: [tenantId], references: [id])
  user         User?             @relation(fields: [userId], references: [id])
  analysis     DocumentAnalysis?

