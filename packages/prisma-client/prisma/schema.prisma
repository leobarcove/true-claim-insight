// ============================================================================
// SLA CLOCKS — turnaround obligations (BNM CSP PD 029-69; Adjuster PD 12.5)
// ============================================================================

/// A stage of the claim journey that carries a turnaround obligation.
/// Firm-side stages are ours to meet; insurer-side stages are measured only, so
/// the firm can evidence where a delay actually originated.
enum SlaStage {
  ACK_TO_INSURER      /// firm acknowledges an appointment — 1 working day
  PRELIMINARY_REPORT  /// market practice, per-insurer target
  FINAL_REPORT        /// 10 working days from complete documents
  SUPPLEMENTARY_CLAIM /// 5 working days
  INSURER_DECISION    /// insurer side: 7 working days — monitored, not owned
  INSURER_PAYMENT     /// insurer side: 14 working days non-motor — monitored
}

enum SlaClockState {
  RUNNING
  PAUSED   /// stopped by a dependency outside the firm's control
  MET      /// completed on or before the deadline
  BREACHED /// deadline passed while still running
}

/// Configured turnaround target for one stage.
///
/// `tenantId` null is the platform default; a row with a tenantId overrides it
/// for that insurer, which is what makes white-label multi-panel operation
/// possible without code changes.
model SlaPolicy {
  id                    String   @id @default(uuid())
  tenantId              String?
  stage                 SlaStage
  workingDays           Int
  /// Warn this many working days before the deadline. Skipped when the target
  /// is not longer than the warning window — a 1-day SLA cannot warn early.
  warnWorkingDaysBefore Int      @default(1)
  /// Malaysian state whose weekend pattern and holidays apply. Null uses the
  /// national calendar (Saturday–Sunday).
  calendarState         String?
  /// Insurer-side stages: measure and report, never escalate against the firm.
  monitorOnly           Boolean  @default(false)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant Tenant?    @relation(fields: [tenantId], references: [id])
  clocks SlaClock[]

  @@unique([tenantId, stage])
  @@index([stage])
  @@map("sla_policies")
}

/// A running deadline against one claim and stage.
///
/// History is kept: a stage may legitimately recur (a second supplementary
/// claim), so completed clocks are never overwritten. A partial unique index
/// added in the migration guarantees at most one RUNNING or PAUSED clock per
/// claim and stage, so the state cannot become ambiguous.
model SlaClock {
  id String @id @default(uuid())

  /// A clock hangs on a claim *or* on an assignment. The acknowledgement
  /// obligation falls due before any claim exists — that is why it could not be
  /// measured until `Assignment` existed — so exactly one of these is set.
  claimId      String?
  assignmentId String?

  policyId String
  stage    SlaStage
  state    SlaClockState @default(RUNNING)

  startedAt DateTime @default(now())
  /// Deadline in working days from startedAt, per the policy's calendar.
  dueAt     DateTime

  pausedAt DateTime?
  /// Working days that remained when the clock was paused. The deadline is
  /// recomputed from the resume date, so a pause never silently consumes time.
  remainingWorkingDaysAtPause Int?
  pauseReason                 String?

  stoppedAt   DateTime?
  breachedAt  DateTime?
  /// Set when the due-soon warning has fired, so it fires once.
  warnedAt    DateTime?
  /// Raised on each escalation step after a breach.
  escalationLevel Int @default(0)

  metadata  Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claim      Claim?      @relation(fields: [claimId], references: [id], onDelete: Cascade)
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  policy     SlaPolicy   @relation(fields: [policyId], references: [id])

  @@index([claimId])
  @@index([assignmentId])
  @@index([state, dueAt])
  @@index([stage])
  @@map("sla_clocks")
}

// ============================================================================
// ADJUSTER REPORTS — the firm's core work product (BNM Adjuster PD 12.6–12.7)
// ============================================================================

enum AdjusterReportType {
  PRELIMINARY
  INTERIM
  FINAL
  SUPPLEMENTARY
}

enum AdjusterReportStatus {
  DRAFT     /// being written by the author
  IN_REVIEW /// submitted, awaiting sign-off
  SIGNED    /// signed by a qualified adjusting employee
  ISSUED    /// released to the insurer — immutable from here
  WITHDRAWN /// superseded or retracted, retained for the record
}

/// An adjuster's report on a claim.
///
/// PD 12.7 restricts authorship to adjusting employees and requires a junior's
/// report to be signed by a senior, so `authorAdjusterId` and `signedByAdjusterId`
/// are separate and both point at Adjuster rather than User — a report cannot be
/// authored by someone who is not an adjusting employee.
///
/// PD 12.6 requires the report to disclose facts, assumptions, methods, sources
/// and databases relied on. Those sections are mandatory in the template registry
/// and cannot be signed while empty.
///
/// Reports are never edited after issue. A correction supersedes the previous
/// version via `supersedesId`, so the record shows what was told to the insurer
/// and when — which is the question a s.146 examination asks.
model AdjusterReport {
  id      String               @id @default(uuid())
  claimId String
  type    AdjusterReportType
  status  AdjusterReportStatus @default(DRAFT)

  /// Increments per claim and type; a superseding report carries the next number.
  version     Int     @default(1)
  supersedesId String? @unique

  /// Section key → { heading, body, aiAssisted }. The template registry defines
  /// which keys are mandatory; see report-templates.ts.
  sections Json @default("{}")

  authorAdjusterId   String
  reviewerAdjusterId String?
  signedByAdjusterId String?

  /// Recorded when the countersign requirement could not be verified against
  /// seniority data, so the basis of a sign-off is never silently assumed.
  countersignBasis String?

  submittedAt DateTime?
  signedAt    DateTime?
  issuedAt    DateTime?

  withdrawnAt     DateTime?
  withdrawnReason String?

  /// Rendered PDF, once issued.
  renderedDocumentId String?

  metadata  Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claim      Claim           @relation(fields: [claimId], references: [id], onDelete: Cascade)
  author     Adjuster        @relation("ReportAuthor", fields: [authorAdjusterId], references: [id])
  reviewer   Adjuster?       @relation("ReportReviewer", fields: [reviewerAdjusterId], references: [id])
  signedBy   Adjuster?       @relation("ReportSigner", fields: [signedByAdjusterId], references: [id])
  supersedes AdjusterReport? @relation("ReportSupersession", fields: [supersedesId], references: [id])
  supersededBy AdjusterReport? @relation("ReportSupersession")

  @@index([claimId])
  @@index([status])
  @@index([authorAdjusterId])
  @@map("adjuster_reports")
}

// ============================================================================
// AUTHORITY LIMITS — segregation of duties (§4.3 A3; PD 11.2(d))
// ============================================================================

/// Who may approve a claim, and up to what value.
///
/// The defect this closes: an adjuster could assess a claim and approve it in
/// the same breath, at any amount, with nothing recording that the same person
/// did both. Segregation of duties is the control every financial-services
/// examiner looks for first, and its absence is not mitigated by good intent.
///
/// A limit may be attached to a role (everyone holding it) or to a named
/// adjuster (which takes precedence). `maxApprovalAmount` null means unlimited
/// — deliberate and explicit rather than implied by an absent row, because
/// "no limit configured" and "no limit intended" must not look the same.
model AuthorityLimit {
  id       String  @id @default(uuid())
  tenantId String

  /// Applies to everyone holding this role. Mutually exclusive with adjusterId.
  role       UserRole?
  /// Applies to one named adjuster, overriding any role limit.
  adjusterId String?

  /// Null applies to every claim category.
  category ClaimCategory?

  /// Null means no ceiling. Absence of a row means no authority at all.
  maxApprovalAmount Decimal? @db.Decimal(14, 2)

  /// May the holder approve a claim they assessed themselves? Default false —
  /// the four-eyes principle is the point of the model.
  canApproveOwnAssessment Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  adjuster Adjuster? @relation(fields: [adjusterId], references: [id])

  @@index([tenantId, role])
  @@index([adjusterId])
  @@map("authority_limits")
}

// ============================================================================
// CONSENT — PDPA 2010 lawful basis, notice and withdrawal
// ============================================================================

enum ConsentPurpose {
  CLAIM_PROCESSING     /// handling the claim itself
  BIOMETRIC_ANALYSIS   /// voice and facial analysis — sensitive personal data
  CROSS_BORDER_TRANSFER /// s.129(3)(a) basis for offshore processors
}

enum ConsentStatus {
  GRANTED
  WITHDRAWN
}

enum ConsentChannel {
  WEB_FORM
  VIDEO_SESSION
  STAFF_CAPTURED
  IMPORTED
}

/// The wording a data subject was shown, versioned and approved.
///
/// PDPA s.7 requires written notice in **both English and Bahasa Malaysia**, so
/// a notice version is incomplete until both locales exist — enforced in the
/// service, not left to whoever writes the seed.
///
/// A notice is immutable once approved. Consent is only meaningful if the exact
/// wording the subject agreed to can be reproduced years later; editing it in
/// place would make every prior consent unprovable.
model ConsentNotice {
  id      String         @id @default(uuid())
  purpose ConsentPurpose
  version Int
  /// `en` or `ms`.
  locale  String

  title String
  body  String

  /// Null means draft. An unapproved notice can never be shown to a data
  /// subject or recorded against — the gate is in the service.
  approvedByUserId String?
  approvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consents Consent[]

  @@unique([purpose, version, locale])
  @@index([purpose, approvedAt])
  @@map("consent_notices")
}

/// One data subject's consent to one purpose.
///
/// Withdrawal does not delete the record — PDPA gives a right to withdraw, and
/// evidencing *when* processing became unlawful requires the original grant to
/// survive alongside the withdrawal.
model Consent {
  id         String         @id @default(uuid())
  claimantId String
  purpose    ConsentPurpose
  status     ConsentStatus  @default(GRANTED)

  /// Exactly which wording, in which language, the subject agreed to.
  noticeId String

  grantedAt   DateTime  @default(now())
  withdrawnAt DateTime?
  withdrawalReason String?

  capturedVia ConsentChannel @default(WEB_FORM)
  ipAddress   String?
  /// Staff member who captured it, when not self-served.
  capturedByUserId String?

  metadata  Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claimant Claimant      @relation(fields: [claimantId], references: [id], onDelete: Cascade)
  notice   ConsentNotice @relation(fields: [noticeId], references: [id])

  @@index([claimantId, purpose])
  @@index([status])
  @@map("consents")
}

// ============================================================================
// ASSIGNMENT — the insurer's appointment (CSP ack ≤1 working day; PD 11.2(a))
// ============================================================================

/// What the firm was appointed to do. Drives which gate set applies.
enum AssignmentMode {
  TPA_ADMIN /// claims administration on the insurer's behalf
  ADJUSTING /// independent adjusting, issuing an adjuster's report
}

/// How the appointment reached the firm. Merimen is the market's rail; the
/// others exist because access to it is insurer-sponsored and not guaranteed
/// (docs/MASTER_PLAN.md §6.4), so no schema assumes it.
enum AssignmentChannel {
  EMAIL
  PORTAL
  MERIMEN
  API
  MANUAL
}

enum AssignmentStatus {
  RECEIVED     /// logged, acknowledgement outstanding
  ACKNOWLEDGED /// ack sent to the insurer — stops the CSP clock
  ACCEPTED     /// work under way; a claim has been opened
  DECLINED     /// refused, with a reason
  COMPLETED    /// closed out
}

/// An insurer's instruction to handle a matter.
///
/// The claim journey previously began at `Claim`, which meant it began when the
/// firm decided to start work rather than when the insurer asked — leaving no
/// record of the appointment and nothing for the CSP one-working-day
/// acknowledgement to be measured from. PD 11.2(a) expects the adjusting process
/// to be embodied end to end; this is the missing front end.
///
/// A claim is opened *from* an assignment rather than the other way round. The
/// relation is optional because an assignment can be declined before any claim
/// exists, and that refusal is itself part of the record.
model Assignment {
  id String @id @default(uuid())

  /// Who appointed the firm.
  insurerTenantId String
  /// The adjusting firm instructed.
  handlingTenantId String

  mode    AssignmentMode    @default(TPA_ADMIN)
  channel AssignmentChannel @default(EMAIL)
  status  AssignmentStatus  @default(RECEIVED)

  /// The insurer's own reference — a Merimen number, an email subject ref, a
  /// claim number in their system. Unique per insurer so the same appointment
  /// ingested twice does not become two, which matters most for automated
  /// channels where a retry is normal.
  externalRef String

  /// What the firm was asked to assess, in the insurer's words.
  scope        String?
  instructions String?

  appointedByName  String?
  appointedByEmail String?

  /// When the instruction arrived — the moment the CSP clock starts from, which
  /// is not the same as when the row was written.
  receivedAt DateTime @default(now())
  /// When the acknowledgement went back to the insurer.
  acknowledgedAt DateTime?
  declinedAt     DateTime?
  declineReason  String?
  completedAt    DateTime?

  /// The claim opened for this appointment, once one exists.
  claimId String? @unique

  metadata  Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  insurer       Tenant @relation("AssignmentInsurer", fields: [insurerTenantId], references: [id])
  handlingFirm  Tenant @relation("AssignmentHandlingFirm", fields: [handlingTenantId], references: [id])
  claim         Claim? @relation(fields: [claimId], references: [id])

  @@unique([insurerTenantId, externalRef])
  @@index([handlingTenantId, status])
  @@index([status, receivedAt])
  @@map("assignments")
  slaClocks     SlaClock[]
}

// ============================================================================
// RETENTION — PD 12.8: records kept ≥7 years; purge is scheduled, never manual
// ============================================================================

/// How long each kind of record is kept after its claim closes.
///
/// A table rather than a constant so a panel insurer's contract can demand
/// longer — but never shorter: the PD 12.8 seven-year floor is enforced in code
/// and asserted by test, so no row can quietly undercut it.
model RetentionPolicy {
  id         String  @id @default(uuid())
  /// e.g. DOCUMENT, VIDEO_UPLOAD. One row per kind.
  entityType String  @unique
  /// Years after claim closure before a purge becomes permissible.
  retainYears Int    @default(7)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("retention_policies")
}

// ============================================================================
// CROSS-BORDER TRANSFER REGISTER — PDPA s.129; CBPDT Guidelines (April 2025)
// ============================================================================

/// One transfer of personal data to a recipient outside Malaysia.
///
/// The CBPDT Guidelines require the data controller to keep records of each
/// cross-border transfer: recipient, country, type of data, purpose, and
/// evidence of the s.129 basis relied on. Until now every Gemini, Hume and
/// Daily.co call moved claimant data offshore with no record at all.
///
/// `lawfulBasis` is nullable on purpose: where no basis has been established
/// yet, the honest record says so — a register that invents a basis is worse
/// than the gap it papers over.
model TransferRecord {
  id String @id @default(uuid())

  /// Recipient service, from the provider registry (e.g. HUME_AI, GOOGLE_GEMINI).
  provider String
  /// Country the recipient processes in.
  country  String

  /// What was sent, in words a regulator can read.
  dataDescription String
  /// Why it was sent.
  purpose String
  /// s.129 basis relied on, e.g. "CONSENT s.129(3)(a)". Null = none established.
  lawfulBasis String?

  /// Which service initiated the transfer.
  sourceService String

  claimId    String?
  claimantId String?

  transferredAt DateTime @default(now())
  metadata      Json?    @default("{}")

  @@index([provider, transferredAt])
  @@index([claimId])
  @@map("transfer_records")
}

// ============================================================================
// ADJUSTER COMPETENCY — PD 12.2(b), 12.3, 12.4: who may do which adjusting work
// ============================================================================

/// An adjusting employee's standing in one subject matter.
///
/// PD 12.4 makes seniority a *recognition*, not an arithmetic: five years in the
/// subject (12.4(a)) is the floor, and the firm must also weigh case volume and
/// performance (12.4(b)) before recognising someone as senior. So the model
/// records the inputs and the recognition act separately — `yearsInSubject`
/// alone never makes anyone senior.
model AdjusterCompetency {
  id         String        @id @default(uuid())
  adjusterId String
  category   ClaimCategory

  /// Years of adjusting experience in this subject matter (12.4(a)).
  yearsInSubject Int
  /// Relevant cases handled (12.4(b)(i)) — an input to recognition, kept current.
  casesHandled   Int @default(0)
  /// 12.4(b)(ii): satisfactory performance across relevant cases.
  performanceSatisfactory Boolean @default(false)

  /// The recognition act (12.4): a named person, on a date, decided this
  /// adjuster is senior in this subject. Absent = not senior, whatever the years.
  seniorRecognisedAt       DateTime?
  seniorRecognisedByUserId String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adjuster Adjuster @relation(fields: [adjusterId], references: [id], onDelete: Cascade)

  @@unique([adjusterId, category])
  @@index([category])
  @@map("adjuster_competencies")
}

// ============================================================================
// CONFLICT OF INTEREST — PD 10.3, 11.2(c), 12.1(d)
// ============================================================================

enum ConflictPartyType {
  INSURER
  TAKAFUL_OPERATOR
  WORKSHOP
  CLAIMANT
  OTHER
}

enum ConflictInterestType {
  EMPLOYMENT
  EQUITY
  FAMILY
  FINANCIAL
  OTHER
}

/// A standing declaration of a relation or interest (PD 10.3).
///
/// The PD reaches spouses, children, parents, siblings and other immediate
/// family — so `relationship` records *whose* interest it is, and a declaration
/// is never deleted: it is resolved, with a reason, because "we knew and dealt
/// with it" is the record that protects the firm, while a deleted row protects
/// nobody.
model ConflictDeclaration {
  id         String @id @default(uuid())
  adjusterId String

  partyType    ConflictPartyType
  interestType ConflictInterestType
  /// The party's name as declared (e.g. an insurer or workshop name).
  partyName    String
  /// When the party is a tenant on the platform, the id enables automatic
  /// screening against a claim's insurer — a name match alone is weaker.
  partyTenantId String?

  /// Whose interest: SELF, SPOUSE, CHILD, PARENT, SIBLING, OTHER_FAMILY.
  relationship String
  details      String?

  declaredAt       DateTime  @default(now())
  declaredByUserId String
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adjuster Adjuster @relation(fields: [adjusterId], references: [id], onDelete: Cascade)

  @@index([adjusterId, resolvedAt])
  @@index([partyTenantId])
  @@map("conflict_declarations")
}

/// The per-claim attestation (PD 12.1(d)): the assigned adjuster confirms, for
/// this specific claim, that no undeclared conflict exists — or declares one.
model ConflictAttestation {
  id         String  @id @default(uuid())
  claimId    String
  adjusterId String

  hasConflict Boolean @default(false)
  note        String?
  attestedAt  DateTime @default(now())

  claim    Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  adjuster Adjuster @relation(fields: [adjusterId], references: [id], onDelete: Cascade)

  @@unique([claimId, adjusterId])
  @@map("conflict_attestations")
}

// ============================================================================
// CPD LEDGER — PD 12.9–12.11: 15 hours per adjusting employee per year
// ============================================================================

/// One CPD activity attended by an adjusting employee.
///
/// PD 12.11 directs the firm to the Association of Malaysian Loss Adjusters (or
/// institutions BNM specifies) on which programmes *qualify* — so recognition
/// is recorded per entry, and only recognised hours count toward the 12.10
/// floor. Unrecognised attendance is still recorded: it is true, it is just not
/// the currency the floor is denominated in.
model CpdRecord {
  id         String @id @default(uuid())
  adjusterId String

  /// Calendar year the hours count toward.
  year  Int
  hours Decimal @db.Decimal(5, 1)

  programmeName String
  provider      String
  /// Qualifies per PD 12.11 (AMLA-the-association or a BNM-specified institution).
  providerRecognised Boolean @default(false)

  completedAt DateTime
  /// Certificate or attendance evidence, when held.
  evidenceUrl String?
  notes       String?

  recordedByUserId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  adjuster Adjuster @relation(fields: [adjusterId], references: [id], onDelete: Cascade)

  @@index([adjusterId, year])
  @@map("cpd_records")
}

// ============================================================================
// BACKGROUND SCREENING — PD 11.2(e): due diligence prior to employment
// ============================================================================

/// The check kinds 11.2(e) names as the minimum.
enum ScreeningCheckType {
  BANKRUPTCY_INSOLVENCY
  EMPLOYMENT_HISTORY
  ACADEMIC_HISTORY
  CRIMINAL_SCREENING
  OTHER
}

enum ScreeningOutcome {
  CLEAR
  FINDINGS
}

/// One background check on an adjusting employee.
///
/// 11.2(e) says *prior to employment* — so a check dated after `adjustingSince`
/// is recorded (late screening beats none) but flagged as late rather than
/// silently counted as compliant. FINDINGS is a legitimate outcome: the record
/// of "we found it, considered it and hired anyway" is exactly what protects
/// the firm; only an undescribed finding is refused.
model BackgroundScreening {
  id         String @id @default(uuid())
  adjusterId String

  checkType ScreeningCheckType
  outcome   ScreeningOutcome
  /// Required when the outcome is FINDINGS.
  findingsNote String?

  /// When the check was performed — may predate the adjuster record.
  screenedAt  DateTime
  /// Who performed it (an agency, a registry search, a named person).
  conductedBy String
  evidenceUrl String?

  recordedByUserId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  adjuster Adjuster @relation(fields: [adjusterId], references: [id], onDelete: Cascade)

  @@index([adjusterId, checkType])
  @@map("background_screenings")
}

// ============================================================================
// COMPLIANCE EVENTS — PD 11.2(d): timely escalation of issues to the Board
// ============================================================================

enum ComplianceEventType {
  SLA_BREACH_ESCALATED
  COI_CONFLICT_ATTESTED
  POLICY_BREACH
  AUDIT_GAP
  OTHER
}

enum ComplianceEventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplianceEventStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

/// An issue on its way to the Board (PD 11.2(d)).
///
/// Events are raised by the system where the controls already are — a firm-side
/// SLA breach reaching escalation level 3, an adjuster attesting a conflict —
/// and by hand for everything else. `dedupeKey` makes system raising idempotent:
/// the SLA sweep runs every fifteen minutes, and a breach that raised a fresh
/// event per sweep would bury the register it exists to feed.
model ComplianceEvent {
  id String @id @default(uuid())

  type     ComplianceEventType
  severity ComplianceEventSeverity
  status   ComplianceEventStatus @default(OPEN)

  title   String
  details String?

  claimId    String?
  adjusterId String?

  /// Null for system-raised events; the raising control is named in `source`.
  raisedByUserId String?
  source         String

  /// Unique per underlying fact, so the same breach raises one event however
  /// many sweeps observe it.
  dedupeKey String? @unique

  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  resolvedAt           DateTime?
  resolvedByUserId     String?
  resolutionNote       String?

  /// When this event was included in a Board report — the 11.2(d) act itself.
  boardReportedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, severity])
  @@index([boardReportedAt])
  @@map("compliance_events")
}

// ============================================================================
// FIT AND PROPER — PD 10.1/10.2: shareholders and key responsible persons
// ============================================================================

enum KeyPersonType {
  SHAREHOLDER
  KRP
  SHAREHOLDER_AND_KRP
}

/// A shareholder or key responsible person of the firm.
///
/// Kept as a register with appointment and cessation dates because PD 13.1
/// makes changes to directors, CEO and shareholders notifiable to BNM within
/// seven working days — when `BnmNotification` is built, these dates are what
/// it hangs on.
model KeyPerson {
  id String @id @default(uuid())

  fullName String
  type     KeyPersonType
  /// e.g. Director, CEO, Head of Claims — free text; `type` drives the criteria.
  position String?

  appointedAt DateTime
  ceasedAt    DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attestations FitProperAttestation[]

  @@index([type, ceasedAt])
  @@map("key_persons")
}

/// One fit-and-proper attestation for one person.
///
/// `responses` maps each applicable criterion code to its outcome and note.
/// `allMet` is denormalised for the register listing; the truth stays in the
/// responses. A NOT_MET outcome does not block recording — the honest record of
/// an unfit finding is the whole point — it raises a compliance event instead.
model FitProperAttestation {
  id          String @id @default(uuid())
  keyPersonId String

  /// { [criterionCode]: { outcome: 'MET' | 'NOT_MET', note?: string } }
  responses Json
  allMet    Boolean

  attestedAt       DateTime @default(now())
  attestedByUserId String
  notes            String?

  keyPerson KeyPerson @relation(fields: [keyPersonId], references: [id], onDelete: Cascade)

  @@index([keyPersonId, attestedAt])
  @@map("fit_proper_attestations")
}
