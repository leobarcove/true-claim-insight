# True Claim Insight - Adjuster Portal Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
# Leave UNSET for local development. The app falls back to the same-origin path
# /api/v1, which vite.config.ts proxies to the gateway on API_GATEWAY_PORT from
# the root .env — so the gateway port is written in exactly one place, and the
# setup matches staging, where the Caddy edge makes the API same-origin too.
# Set this only to point the portal at a non-local gateway.
# VITE_API_URL=

# Application Settings
VITE_APP_NAME="True Claim Insight"
VITE_APP_VERSION=0.1.0

# Feature Flags
VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_MOCK_DATA=true

# Video Service (Tencent TRTC)
# These will be provided by the video-service API
VITE_TRTC_SDK_APP_ID=

# Analytics (Optional)
VITE_ANALYTICS_ID=
