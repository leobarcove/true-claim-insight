# ============================================================================
# True Claim Insight — STAGING environment (.env.staging)
#
# Generate the real file with:  ./generate-staging-secrets.sh
# Never commit .env.staging. Never reuse dev or production values here —
# every secret is fresh per environment.
#
# STAGING HOLDS SYNTHETIC DATA ONLY — seeded demo identities, never a real
# NRIC, recording or bank account.
# ============================================================================

NODE_ENV=production
LOG_LEVEL=info

# ---- Compose-level scalars (interpolated into docker-compose.staging.yml) ----
# Postgres superuser password — internal-only, but still generated fresh.
POSTGRES_PASSWORD=

# Public hostnames served by the Caddy edge. With real DNS names, TLS is
# automatic via Let's Encrypt. For local verification use http:// addresses:
#   ADJUSTER_HOST=http://adjuster.localhost   CADDY_HTTP_PORT=8088
ADJUSTER_HOST=adjuster.staging.example.com
CLAIMANT_HOST=claim.staging.example.com

# Full origins as the browser sees them (scheme + host [+ port]). Used for
# CORS and for the public URLs of locally-stored files.
ADJUSTER_ORIGIN=https://adjuster.staging.example.com
CLAIMANT_ORIGIN=https://claim.staging.example.com

CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ---- Secrets (all generated by the script; none may be copied from dev) ----
JWT_SECRET=
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800
COOKIE_SECRET=

# Shared secret proving a request came from the api-gateway; case-service,
# video-service and risk-engine refuse forwarded identity headers without it.
INTERNAL_API_KEY=

# Master key (KEK) for field-level encryption. 32 bytes, base64.
# STORE A COPY IN A PASSWORD MANAGER BEFORE FIRST BOOT — losing it makes
# encrypted staging data unrecoverable. Production custody will be AWS KMS.
ENCRYPTION_MASTER_KEY=

# Pepper for the NRIC blind index. Effectively permanent for this
# environment — changing it breaks every stored nricHash. Back it up with
# the master key.
NRIC_INDEX_PEPPER=

# ---- Data-dependent ----
# ADJUSTING_FIRM tenant id for claimant self-service intake. Fill in AFTER
# seeding: the seed prints tenant ids, or query the tenants table.
HANDLING_FIRM_TENANT_ID=

# ---- Third-party providers (staging/sandbox credentials, optional) ----
# Empty values disable the integration or fall back (Supabase empty = local
# filesystem storage, which is the staging default).
DAILY_API_KEY=
DAILY_DOMAIN=
GEMINI_API_KEY=
HUME_API_KEY=
LLM_PROVIDER=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=

# ---- SMTP (no code sends mail yet; notifications are deferred pending the
# production hosting build-out — see MASTER_PLAN. SES ap-southeast-5 is the
# decided direction.) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
