# Boot-test environment for CI (ci/verify-images.sh). NOT SECRETS: these are
# dummy values for a throwaway Postgres and Redis that exist for one CI job.
#
# Just enough for each service to reach "Nest application successfully
# started". development mode skips the production-only requirements
# (Supabase, WhatsApp, SMTP) that a boot test has no business holding.
NODE_ENV=development
DATABASE_URL=postgresql://postgres:smoke@smoke-pg:5432/tci
REDIS_URL=redis://smoke-redis:6379
REDIS_HOST=smoke-redis
REDIS_PORT=6379
ENCRYPTION_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
NRIC_INDEX_PEPPER=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
JWT_SECRET=smoke-test-only-not-a-secret-000000000000
JWT_REFRESH_SECRET=smoke-test-only-not-a-secret-111111111111
INTERNAL_API_KEY=smoke-test-only-internal-key-0000000000
